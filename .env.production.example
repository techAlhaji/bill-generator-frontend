# ==============================================================================
# Stellar Bill Generator — Frontend Production / Testnet Environment Variables
# ==============================================================================
# NOTE: Do NOT place secret keys, API tokens, or private credentials in this file.
# Every variable prefixed with NEXT_PUBLIC_ is embedded directly into client bundles!

# Public Base URL for Merchant Dashboard and Web Application
NEXT_PUBLIC_APP_URL="https://stellar-bills.example.com"

# Public REST API Base URL (Backend Fastify Gateway)
NEXT_PUBLIC_API_URL="https://api.stellar-bills.example.com/api/v1"

# Stellar Network Target ("TESTNET" or "PUBLIC" - Testnet only for this release)
NEXT_PUBLIC_STELLAR_NETWORK="TESTNET"

# Network Passphrase for Stellar Testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Public Stellar Horizon API Node
NEXT_PUBLIC_HORIZON_URL="https://horizon-testnet.stellar.org"

# Public Soroban RPC Node (Protocol 22 Testnet)
NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Deployed Soroban Invoice Registry Contract ID (Testnet Release)
NEXT_PUBLIC_INVOICE_REGISTRY_CONTRACT_ID="CCG6V5QEJZ2QI7EXIRVQXCHUIFUROXUBMZPTSCRJHOO35CAQ2HZ6IJGC"
